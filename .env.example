# Copy to ".env" (repo root) and fill in what you use. Every value here
# is optional — with none of them set, the blueprint runs fully offline:
# the deterministic rules backend, in-memory test doubles, samples.
# Real environment variables always override this file.

# --- Reasoning backend -----------------------------------------------
# muse (the lead profile) | llm | openai | anthropic | ollama |
# offline (default). The loops, guardrails and gate are identical for
# every backend; only the engine behind the three round calls changes.
REASONING_BACKEND=offline

# Muse Spark — Meta Model API (the lead provider for this blueprint).
# Get a key at dev.meta.ai (dashboard → API keys). The adapter defaults
# to https://api.meta.ai/v1 and model muse-spark-1.3.
# REASONING_BACKEND=muse
# MODEL_API_KEY=
# MODEL_API_BASE_URL=https://api.meta.ai/v1
# MUSE_MODEL=muse-spark-1.3
# Reasoning continuity across loop rounds (Responses API): without it,
# each round restarts the model's reasoning from scratch. Set
# MODEL_SURFACE=responses to carry reasoning.encrypted_content between
# rounds instead of using Chat Completions.
# MODEL_SURFACE=responses

# Other providers, behind the same port (structured-output adapter).
# REASONING_BACKEND=llm picks: ANTHROPIC_API_KEY first, else
# OPENAI_API_KEY, else Ollama. Or select directly: =anthropic etc.
# ANTHROPIC_API_KEY=
<redacted>
# OPENAI_API_KEY=
<redacted>
# Any OpenAI-compatible endpoint works via OPENAI_BASE_URL — hosted
# gateways, Azure, LiteLLM, and NVIDIA NIM:
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1   (with an nvapi- key)
# OPENAI_BASE_URL=http://localhost:8000/v1              (self-hosted NIM)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1
# LLM_TIMEOUT_SECONDS=90

# --- Loop budgets -------------------------------------------------------
# Enforced in code, per case and per board run.
# LOOP_MAX_ROUNDS=3
# LOOP_CASE_TOKEN_BUDGET=200000
# BOARD_MAX_CASES=20
# BOARD_TOKEN_BUDGET=1000000

# --- Embeddings (knowledge-base retrieval) ------------------------------
# Default: deterministic hashing embedder (offline stand-in). Set
# EMBEDDER=provider to use OPENAI_API_KEY's /embeddings endpoint instead.
# EMBEDDER=provider
# EMBEDDING_MODEL=text-embedding-3-small

# --- Production persistence (docker compose sets these) -----------------
# PostgreSQL: case records + LangGraph checkpoints + pgvector index.
# DATABASE_URL=postgresql://plantops:plantops@localhost:5432/plantops
# CHECKPOINTS=off
# S3-compatible bucket for raw case payloads:
# S3_BUCKET=case-payloads
# S3_ENDPOINT_URL=http://localhost:8333
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# --- API ------------------------------------------------------------------
# Optional shared key: when set, routes require the X-API-Key header.
# API_KEY=
